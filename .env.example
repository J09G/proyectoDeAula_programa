

SPRING_PROFILES_ACTIVE=dev

# Local:  mongodb://localhost:27017/parking
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/parking?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/parking

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=8080

# Dirección pública de la app, para los enlaces de los correos (recuperar
# contraseña). En Render: https://<tu-servicio>.onrender.com
APP_URL=http://localhost:8080

# TLS del backend.
#   false -> el backend habla HTTP plano (lo correcto detrás de un proxy que ya
#            pone el HTTPS, como Render, y en local con docker compose)
#   true  -> el backend sirve HTTPS y necesita KEYSTORE_PASSWORD
SSL_ENABLED=false
# Sólo si SSL_ENABLED=true: ruta a TU certificado, fuera del repositorio
# (por ejemplo file:C:/certs/parking.p12). Ver README, "HTTPS en local".
KEYSTORE_PATH=
KEYSTORE_ALIAS=parking
KEYSTORE_PASSWORD=

# ── Correo transaccional (Brevo) ────────────────────────────────────────────
# Si BREVO_API_KEY queda vacío, la app arranca igual y sólo registra en el log
# los correos que habría enviado. Útil en desarrollo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@parkingapp.local
BREVO_SENDER_NAME=ParkingApp

# ── Usuario superadministrador inicial ──────────────────────────────────────
# Se crea sólo si no existe ningún SuperAdmin en la base de datos.
SUPERADMIN_EMAIL=superadmin@parking.com
SUPERADMIN_PASSWORD=
SUPERADMIN_CEDULA=0000000000

# ── Reglas de negocio (opcionales, tienen valores por defecto) ──────────────
RESERVAS_MINUTOS_TOLERANCIA=120
RESERVAS_INTERVALO_EXPIRACION_MS=900000
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=30

# ── JWT (autentica toda la app: la web por cookie, /api/** por cabecera) ────
# Minimo 256 bits / 32 caracteres para HS256. Sin este valor, en perfil "prod"
# la app se niega a arrancar (ver JwtService).
JWT_SECRET=
JWT_EXPIRATION_MS=1800000

# ── Login con Google (OAuth2) ───────────────────────────────────────────────
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth
# (tipo "Aplicacion web"). URI de redireccion autorizada:
#   local:  http://localhost:8080/login/oauth2/code/google
#   Render: https://<tu-servicio>.onrender.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hora con la que trabaja la aplicacion (reservas, facturas, expiraciones).
# Los servidores en la nube van en UTC; por defecto se usa la de Colombia.
ZONA_HORARIA=America/Bogota

# ── Pagos: anticipo al reservar (Wompi) ─────────────────────────────────────
# Panel de Wompi > Desarrolladores > Llaves del API. En modo pruebas empiezan
# por pub_test_, prv_test_, test_integrity_ y test_events_.
# Sin WOMPI_PUBLIC_KEY y WOMPI_INTEGRITY_SECRET los pagos quedan apagados y las
# reservas funcionan sin cobro.
# Wompi rechaza (403) las URL de retorno con localhost o una IP: para probar en
# local, pon APP_URL=http://lvh.me:8081 (apunta a tu propio equipo) y entra a la
# aplicacion por esa misma direccion.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Opcionales. La privada permite devolver anticipos automaticamente; el secreto
# de eventos, recibir los avisos de Wompi en <APP_URL>/pagos/wompi/eventos.
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Produccion: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1
PAGOS_MINUTOS_PARA_PAGAR=15
PAGOS_MINUTOS_ANTELACION_DEVOLUCION=60
